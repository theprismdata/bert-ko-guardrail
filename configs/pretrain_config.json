{
  "output_dir": "./outputs/pretrain",
  "max_steps": 50000,
  "per_device_train_batch_size": 64,
  "per_device_eval_batch_size": 64,
  "learning_rate": 5e-4,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "lr_scheduler_type": "cosine",
  "optim": "adamw_torch",
  "logging_steps": 100,
  "eval_strategy": "steps",
  "eval_steps": 1000,
  "save_steps": 1000,
  "save_total_limit": 2,
  "seed": 42,
  "report_to": "none",
  "mlm_probability": 0.15,
  "max_seq_length": 256
}
